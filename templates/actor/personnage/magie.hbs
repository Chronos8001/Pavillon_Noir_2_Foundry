<section class="tab magie {{#if active}}active{{/if}}" data-group="primary" data-tab="magie">
{{#with magie}}
<div class="pn2-magie {{#if occupe}}occupe{{/if}}">

  {{!-- ============ Identité religieuse ============ --}}
  <h2><i class="fa-solid fa-place-of-worship"></i> Identité religieuse
    <a class="pn2-mini-btn" data-action="magie" data-op="bibliotheque" title="Bibliothèque de magie : religions, Voies et Pouvoirs"><i class="fa-solid fa-book-bookmark"></i> Bibliothèque</a>
    {{#if isGM}}<a class="pn2-mini-btn" data-action="magie" data-op="evenements" title="Événements divins (MJ)"><i class="fa-solid fa-cloud-bolt"></i> Événements</a>{{/if}}</h2>
  <div class="grid-2">
    <div class="ligne"><label>Religion pratiquée</label>
      {{#if profil.religionItem}}<span><a data-action="magie" data-op="editerObjet" data-id="{{profil.religionItem.id}}">{{profil.religionItem.nom}}</a>
        <a class="pn2-mini-btn" data-action="magie" data-op="retirer" data-id="{{profil.religionItem.id}}" title="Retirer la religion (le document d'origine est conservé)"><i class="fa-solid fa-xmark"></i></a></span>
      {{else}}<input type="text" name="system.magie.religion" value="{{@root.system.magie.religion}}" placeholder="{{@root.system.infos.religion}}" title="Glissez une Religion depuis la bibliothèque pour la lier">{{/if}}</div>
    <div class="ligne"><label>Type</label>
      <select name="system.magie.type"><option value="">{{#if profil.typeDeduit}}D'après la religion : {{lookup types profil.typeDeduit}}{{else}}— À renseigner —{{/if}}</option>{{selectOptions types selected=profil.typeSaisi}}</select></div>
    <div class="ligne"><label>{{statLabel}}{{#if voie}} <span class="hint">({{voie.nom}})</span>{{/if}}</label><strong>{{#if voie}}{{valeurVoie}}{{else}}—{{/if}}</strong></div>
    <div class="ligne"><label>Faveurs <span class="hint">(Chance {{pn2Signed profil.chance}}{{#if profil.faveursMod}} {{pn2Signed profil.faveursMod}}{{/if}})</span></label>
      <span><strong>{{pn2Signed profil.faveurs}}</strong> {{#if isGM}}<input type="number" name="system.magie.faveursMod" value="{{profil.faveursMod}}" title="Modificateur temporaire des Faveurs (MJ)">{{/if}}</span></div>
    <div class="ligne"><label>Colère divine <span class="hint">({{profil.groupeColere}})</span></label>
      <span><strong>{{profil.colereActuelle}}</strong>
        <a class="pn2-btn petit" data-action="magie" data-op="colere" data-groupe="{{profil.groupeColere}}" data-delta="1" title="Ajouter 1 point">+1</a>
        {{#if isGM}}<a class="pn2-btn petit" data-action="magie" data-op="colere" data-groupe="{{profil.groupeColere}}" data-delta="-1" title="Retirer 1 point (MJ)">−1</a>{{/if}}</span></div>
    <div class="ligne"><label>Seuil de Rejet <span class="hint">({{#if (eq prep.mode "transe")}}Transe{{else}}Rituel{{/if}} préparé)</span></label>
      <strong>{{#if apercu.erreur}}<span class="alerte" title="{{apercu.erreur}}">?</span>{{else if seuilVisible}}{{apercu.seuil.seuil}}{{else}}<span class="hint">connu du MJ</span>{{/if}}</strong></div>
  </div>
  {{#each profil.colere}}{{#unless principal}}
    <div class="ligne"><label class="hint">Colère ({{groupe}})</label><span>{{valeur}}{{#if ../isGM}} <a class="pn2-btn petit" data-action="magie" data-op="colere" data-groupe="{{groupe}}" data-delta="-1">−1</a>{{/if}}</span></div>
  {{/unless}}{{/each}}
  {{#if isGM}}<a class="pn2-btn petit" data-action="magie" data-op="recuperer" title="Applique maintenant la récupération horaire selon le temps du monde"><i class="fa-solid fa-hourglass-half"></i> Récupération de la Colère</a>{{/if}}

  {{!-- ============ Auspices ============ --}}
  <h2><i class="fa-solid fa-star-and-crescent"></i> Auspices</h2>
  <div class="pn2-auspices">
    <label>Actes de foi <input type="number" min="0" name="system.magie.actesFoi" value="{{profil.actesFoi}}"></label>
    <span>−</span>
    <label>Péchés <input type="number" min="0" name="system.magie.peches" value="{{profil.peches}}"></label>
    <span>+</span>
    <label>Affinité <strong>{{#if voie}}{{pn2Signed voie.affinite}}{{else}}—{{/if}}</strong></label>
    <span>+</span>
    <label>Beauté des rites {{#if isGM}}<input type="number" data-prep="beaute" value="{{prep.beaute}}" {{#if prep.instantanee}}disabled{{/if}}>{{else}}<em class="hint">fixée par le MJ</em>{{/if}}</label>
    <span>=</span>
    <label>Total <strong>{{#if seuilVisible}}{{#if apercu.auspices}}{{pn2Signed apercu.auspices.total}}{{else}}—{{/if}}{{else}}<span class="hint">MJ</span>{{/if}}</strong></label>
  </div>
  {{#if consequences.malusVoie}}<p class="alerte">Séquelles de Rejet dans cette Voie : −{{consequences.malusVoie}} aux Auspices (compté avec les Péchés).</p>{{/if}}
  <p class="hint">Actes de foi et Péchés sont enregistrés sur la fiche ; l'Affinité est celle de la Voie choisie ; la Beauté des rites ne vaut que pour l'acte préparé.</p>

  {{!-- ============ Voies ============ --}}
  <h2><i class="fa-solid fa-route"></i> Voies d'illumination
    <a class="pn2-mini-btn" data-action="magie" data-op="creerObjet" data-type="voie" title="Nouvelle Voie (sans compendium)"><i class="fa-solid fa-plus"></i></a></h2>
  <table class="pn2-mini">
    <tr><th>Voie</th><th>Religion</th><th title="Foi">Foi</th><th title="Connaissance des Mystères">Myst.</th><th>Affinité</th><th>Pouvoirs</th><th></th></tr>
    {{#each profil.voies}}
    <tr class="{{#if (eq id ../prep.voieId)}}choisie{{/if}}">
      <td><a data-action="magie" data-op="editerObjet" data-id="{{id}}">{{nom}}</a>{{#if domaine}}<div class="hint">{{domaine}}</div>{{/if}}{{#if sansTranse}}<div class="hint">sans Transe</div>{{/if}}</td>
      <td>{{religion}}</td><td>{{foi}}</td><td>{{mysteres}}</td><td>{{pn2Signed affinite}}</td><td>{{pouvoirs.length}}</td>
      <td class="actions"><a data-action="magie" data-op="editerObjet" data-id="{{id}}" title="Fiche"><i class="fa-solid fa-pen"></i></a>
        <a data-action="magie" data-op="retirer" data-id="{{id}}" title="Retirer du personnage"><i class="fa-solid fa-xmark"></i></a></td>
    </tr>
    {{else}}<tr><td colspan="7" class="hint">Aucune Voie : ouvrez la bibliothèque et ajoutez-en une.</td></tr>{{/each}}
  </table>

  {{!-- ============ Pouvoirs ============ --}}
  <h2><i class="fa-solid fa-hand-sparkles"></i> Pouvoirs connus
    {{#if voie}}<a class="pn2-mini-btn" data-action="magie" data-op="creerObjet" data-type="pouvoir" title="Nouveau Pouvoir dans « {{voie.nom}} »"><i class="fa-solid fa-plus"></i></a>{{/if}}</h2>
  <table class="pn2-mini pouvoirs">
    <tr><th>Pouvoir</th><th>Voie</th><th>P</th>{{#if parametresVisibles}}<th>Paramètres de base</th>{{/if}}<th>Transe</th><th></th></tr>
    {{#each pouvoirs}}
    <tr>
      <td><a data-action="magie" data-op="editerObjet" data-id="{{id}}">{{nom}}</a>{{#if nomNatif}} <span class="hint">({{nomNatif}})</span>{{/if}}
        {{#if description}}<details><summary class="hint">Description</summary>{{{description}}}</details>{{/if}}
        {{#if conditions}}<div class="hint">Conditions : {{conditions}}</div>{{/if}}</td>
      <td>{{#if referenceCassee}}<span class="alerte" title="La Voie de ce Pouvoir est introuvable sur le personnage">Voie introuvable</span>{{else}}{{voieNom}}{{/if}}</td>
      <td>{{puissance}}</td>
      {{#if ../parametresVisibles}}<td class="hint">{{#if parametres.portee}}Portée {{parametres.portee}} · {{/if}}{{#if parametres.cible}}Cible {{parametres.cible}} · {{/if}}{{#if parametres.impact}}Impact {{parametres.impact}} · {{/if}}{{#if parametres.duree}}Durée {{parametres.duree}}{{/if}}</td>{{/if}}
      <td><span class="etat-transe {{etatTranse}}">{{etatTranseLabel}}</span></td>
      <td class="actions">{{#if voieId}}{{#unless ../enCours}}<a data-action="magie" data-op="invoquer" data-id="{{id}}" data-voie="{{voieId}}" title="Préparer un Rituel invoquant ce Pouvoir"><i class="fa-solid fa-hands-praying"></i></a>{{/unless}}{{/if}}
        <a data-action="magie" data-op="retirer" data-id="{{id}}" title="Retirer du personnage"><i class="fa-solid fa-xmark"></i></a></td>
    </tr>
    {{else}}<tr><td colspan="6" class="hint">Aucun Pouvoir connu.</td></tr>{{/each}}
  </table>

  {{!-- ============ Conséquences divines ============ --}}
  {{#unless consequences.vide}}
  <h2><i class="fa-solid fa-skull"></i> Conséquences divines</h2>
  {{#if consequences.sequelles.length}}
    <h3>Séquelles</h3>
    <ul class="pn2-journal">{{#each consequences.sequelles}}<li><strong>{{nature}}</strong>{{#if duree}} — {{duree}}{{/if}}{{#if restrictions}} — {{restrictions}}{{/if}}{{#if levee}} <span class="hint">(levée : {{levee}})</span>{{/if}}</li>{{/each}}</ul>
  {{/if}}
  {{#if consequences.penitences.length}}
    <h3>Pénitences</h3>
    <ul class="pn2-journal">{{#each consequences.penitences}}<li>{{description}} <span class="tag">{{etatLabel}}</span>{{#if note}} <span class="hint">{{note}}</span>{{/if}}</li>{{/each}}</ul>
  {{/if}}
  <p class="hint">Les conséquences divines sont attribuées et validées par le MJ.</p>
  {{/unless}}

  {{!-- ============ Acte sacré ============ --}}
  <h2><i class="fa-solid fa-dice-d10"></i> Acte sacré</h2>
  {{#if enCours}}
    <div class="pn2-acte-resume">
      <span><strong>{{#if acte.estRituel}}Rituel{{else}}Transe{{/if}}</strong> — {{acte.etat.voie.nom}} <span class="tag">{{acte.statut}}</span></span>
      <span>{{acte.resume.succes}} Succès · Colère {{acte.resume.colereTotale}}{{#unless acte.estRituel}} · Niveau {{acte.etat.transe.niveau}}{{/unless}}</span>
      <a class="pn2-btn" data-action="magie" data-op="ouvrirActe"><i class="fa-solid fa-up-right-from-square"></i> Ouvrir {{#if acte.estRituel}}le Rituel{{else}}la Transe{{/if}}</a>
    </div>
  {{else if demandeEnAttente}}
    <div class="pn2-demande">
      <p><strong>Demande de {{#if (eq demande.mode "transe")}}Transe{{else}}Rituel{{/if}}</strong> — {{demande.voieNom}}{{#if demande.pouvoirNom}}, Pouvoir « {{demande.pouvoirNom}} »{{/if}}</p>
      {{#if demande.souhait}}<p><em>Souhait :</em> {{demande.souhait}}</p>{{/if}}
      {{#if demande.rites}}<p><em>Rites accomplis :</em> {{demande.rites}}</p>{{/if}}
      {{#if isGM}}
        {{> "systems/pavillon-noir-2/templates/actor/personnage/magie-mj.hbs"}}
        <div class="ligne"><label>Motif d'un refus</label><input type="text" data-prep="motif" value="{{prep.motif}}"></div>
        <div class="boutons">
          <a class="pn2-btn {{#if apercu.erreur}}disabled{{/if}}" data-action="magie" data-op="autoriser"><i class="fa-solid fa-check"></i> Autoriser et commencer</a>
          <a class="pn2-btn" data-action="magie" data-op="refuser"><i class="fa-solid fa-xmark"></i> Refuser</a>
        </div>
      {{else}}
        <p class="hint"><i class="fa-solid fa-hourglass-half"></i> En attente du MJ, qui fixe la Puissance et les Auspices.</p>
        <a class="pn2-btn petit" data-action="magie" data-op="annulerDemande">Retirer la demande</a>
      {{/if}}
    </div>
  {{else}}
    {{#if demandeRefusee}}<p class="alerte">Le MJ a refusé la demande précédente{{#if demande.motifRefus}} : {{demande.motifRefus}}{{/if}}. <a class="pn2-btn petit" data-action="magie" data-op="annulerDemande">Effacer</a></p>{{/if}}
    {{#if profil.voies.length}}
    <div class="pn2-preparation">
      <div class="grid-2">
        <div class="ligne"><label>Acte</label>
          <select data-prep="mode"><option value="rituel" {{#if (eq prep.mode "rituel")}}selected{{/if}}>Rituel</option>{{#if transePossible}}<option value="transe" {{#if (eq prep.mode "transe")}}selected{{/if}}>Transe</option>{{/if}}</select></div>
        <div class="ligne"><label>Voie</label><select data-prep="voieId">{{selectOptions voiesOptions selected=prep.voieId}}</select></div>
        {{#if (eq prep.mode "rituel")}}
          <div class="ligne"><label>Pouvoir invoqué</label><select data-prep="pouvoirId">{{selectOptions pouvoirsOptions selected=prep.pouvoirId}}</select></div>
        {{else}}
          <div class="ligne"><label>Durée des Rites (min)</label><input type="number" min="0" data-prep="dureeRites" value="{{prep.dureeRites}}" {{#if prep.instantanee}}disabled{{/if}}></div>
          <div class="ligne"><label>Transe instantanée</label><input type="checkbox" data-prep="instantanee" {{checked prep.instantanee}}></div>
        {{/if}}
      </div>
      {{#if (eq prep.mode "rituel")}}<div class="ligne"><label>Souhait</label><input type="text" data-prep="souhait" value="{{prep.souhait}}"></div>{{/if}}
      <div class="ligne"><label>Rites accomplis</label><input type="text" data-prep="rites" value="{{prep.rites}}" placeholder="Chants, prière, offrandes…"></div>
      {{#if isGM}}{{> "systems/pavillon-noir-2/templates/actor/personnage/magie-mj.hbs"}}
      {{else}}{{#unless validationRequise}}
        <div class="grid-2">
          {{#if (eq prep.mode "rituel")}}<div class="ligne"><label>Puissance nécessaire</label><input type="number" min="1" max="10" data-prep="puissance" value="{{prep.puissance}}"></div>{{/if}}
          <div class="ligne"><label>Beauté des rites</label><input type="number" data-prep="beaute" value="{{prep.beaute}}" {{#if prep.instantanee}}disabled{{/if}}></div>
        </div>
      {{/unless}}{{/if}}
      {{#if apercu.erreur}}<p class="alerte">{{apercu.erreur}}</p>{{/if}}
      {{#if apercu.avertissement}}<p class="hint">⚠ {{apercu.avertissement}}</p>{{/if}}
      {{#if seuilVisible}}{{#if apercu.seuil.negatif}}<p class="alerte">Seuil de Rejet négatif : le Rejet est certain.</p>{{else if apercu.risque}}<p class="alerte">La Colère actuelle dépasse déjà le Seuil.</p>{{/if}}{{/if}}
      <div class="boutons">
        {{#if validationRequise}}
          <a class="pn2-btn {{#if apercu.erreur}}disabled{{/if}}" data-action="magie" data-op="demander"><i class="fa-solid fa-paper-plane"></i> Demander au MJ</a>
        {{else}}
          <a class="pn2-btn {{#if apercu.erreur}}disabled{{/if}}" data-action="magie" data-op="commencer"><i class="fa-solid fa-play"></i> Commencer {{#if (eq prep.mode "rituel")}}le Rituel{{else}}la Transe{{/if}}</a>
        {{/if}}
      </div>
    </div>
    {{else}}<p class="hint">Ajoutez d'abord une Voie d'illumination.</p>{{/if}}
  {{/if}}
</div>
{{/with}}
</section>
