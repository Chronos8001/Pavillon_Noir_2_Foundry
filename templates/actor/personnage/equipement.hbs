<section class="tab {{#if active}}active{{/if}}" data-group="primary" data-tab="equipement">
  <h2>Bourse</h2>
  {{> "systems/pavillon-noir-2/templates/actor/partials/bourse.hbs" bourse=bourse path="system.richesse"}}
  <h2>Équipement
    <a class="pn2-mini-btn" data-action="itemCreate" data-type="equipement"><i class="fa-solid fa-plus"></i></a>
    <a class="pn2-mini-btn" data-action="itemCreate" data-type="objetPouvoir" title="Nouvel objet de pouvoir"><i class="fa-solid fa-gem"></i></a>
    <a class="pn2-mini-btn" data-action="ouvrirCompendium" data-pack="equipement"><i class="fa-solid fa-book"></i></a>
  </h2>
  <table class="pn2-table">
    <thead><tr><th></th><th>Objet</th><th>Catégorie</th><th>Quantité</th><th>Prix</th><th>Effet</th><th></th></tr></thead>
    <tbody>
    {{#each equipements}}
      <tr class="item" data-item-id="{{id}}">
        <td><img src="{{img}}" width="24" height="24"></td>
        <td><a class="nom" data-action="itemShow">{{name}}</a></td>
        <td>{{system.categorie}}</td><td>{{system.quantite}}</td><td>{{system.prix}}</td><td class="hint">{{system.modificateur}}</td>
        <td><a data-action="itemEdit"><i class="fa-solid fa-pen"></i></a> <a data-action="itemDelete"><i class="fa-solid fa-trash"></i></a></td>
      </tr>
    {{else}}
      <tr><td colspan="7" class="hint">Aucun objet.</td></tr>
    {{/each}}
    </tbody>
  </table>
  <h2>Marchandises <a class="pn2-mini-btn" data-action="itemCreate" data-type="marchandise"><i class="fa-solid fa-plus"></i></a>
    <a class="pn2-mini-btn" data-action="ouvrirCompendium" data-pack="equipement"><i class="fa-solid fa-book"></i></a></h2>
  <table class="pn2-table">
    <thead><tr><th></th><th>Marchandise</th><th>Quantité</th><th>Cours</th><th>Valeur (p8)</th><th></th></tr></thead>
    {{#each marchandises}}
    <tr class="item" data-item-id="{{id}}"><td><img src="{{img}}" width="24" height="24"></td><td><a class="nom" data-action="itemShow">{{name}}</a></td>
      <td>{{system.quantite}} × {{system.unite}}</td><td>{{cours}}</td><td>{{valeur}}</td>
      <td><a data-action="itemEdit"><i class="fa-solid fa-pen"></i></a> <a data-action="itemDelete"><i class="fa-solid fa-trash"></i></a></td></tr>
    {{else}}<tr><td colspan="6" class="hint">Aucune marchandise. Les cargaisons se chargent plutôt sur un navire (onglet Cargaison).</td></tr>{{/each}}
  </table>
</section>
