<div class="pn2-item-sheet">
  <header class="pn2-header item">
    <img class="portrait" src="{{item.img}}" data-edit="img" data-action="editImage">
    <div class="header-main">
      <input class="nom" type="text" name="name" value="{{item.name}}">
      <div class="type hint">{{localize (concat "TYPES.Item." type)}} <a data-action="afficher" title="Afficher dans le chat"><i class="fa-solid fa-comment"></i></a></div>
    </div>
  </header>

  {{#if isType.arme}}
  <div class="grid-2">
    <div class="ligne"><label>Catégorie</label><select name="system.categorie">{{selectOptions categoriesArme selected=system.categorie}}</select></div>
    <div class="ligne"><label>Compétence</label><select name="system.competence">{{selectOptions competences selected=system.competence}}</select></div>
    <div class="ligne"><label>Spécialité (Armes blanches/jet)</label><input type="text" name="system.specialite" value="{{system.specialite}}" placeholder="ex. Rapière, Sabre, Arc"></div>
    <div class="ligne"><label>Caractéristique</label><select name="system.carac">{{selectOptions caracOptions selected=system.carac}}</select></div>
    <div class="ligne"><label>Mod. Efficacité (D)</label><input type="number" name="system.modEff" value="{{system.modEff}}"></div>
    <div class="ligne"><label>Mod. Facilité</label><input type="number" name="system.modFac" value="{{system.modFac}}"></div>
    <div class="ligne"><label>Modificateur de dégâts</label><select name="system.md">{{selectOptions mdOptions selected=system.md}}</select></div>
    <div class="ligne"><label>Bonus de dégâts de l'arme</label><input type="number" name="system.degats" value="{{system.degats}}"></div>
    <div class="ligne"><label>Taille (allonge)</label><select name="system.taille">{{selectOptions tailles selected=system.taille}}</select></div>
    <div class="ligne"><label>Mains</label><input type="number" name="system.mains" value="{{system.mains}}" min="1" max="2"></div>
    <div class="ligne"><label>Portée (m)</label><input type="number" name="system.portee" value="{{system.portee}}"></div>
    <div class="ligne"><label>Recharge</label><input type="text" name="system.recharge" value="{{system.recharge}}"></div>
    <div class="ligne"><label>Cibles multiples</label><input type="text" name="system.cibles" value="{{system.cibles}}"></div>
    <div class="ligne"><label>Qualité</label><select name="system.qualite">{{selectOptions qualites selected=system.qualite}}</select></div>
    <div class="ligne"><label>Catégorie d'escrime</label><select name="system.escrime">{{selectOptions escrimeArmes selected=system.escrime}}</select></div>
    <div class="ligne"><label>Mod. de long feu (arme)</label><input type="number" name="system.longFeuMod" value="{{system.longFeuMod}}"></div>
    <div class="ligne"><label>+1 à l'abordage, -1 sinon</label><input type="checkbox" name="system.bonusAbordage" {{checked system.bonusAbordage}}></div>
    <div class="ligne"><label>Équipée / main gauche</label><span><input type="checkbox" name="system.equipee" {{checked system.equipee}}> <input type="checkbox" name="system.mainGauche" {{checked system.mainGauche}}></span></div>
    <div class="ligne"><label>Prix</label><input type="text" name="system.prix" value="{{system.prix}}"></div>
    <div class="ligne"><label>Quantité</label><input type="number" name="system.quantite" value="{{system.quantite}}"></div>
    <div class="ligne"><label>Arme double</label><select name="system.double">{{selectOptions doubles selected=system.double}}</select></div>
  </div>
  {{#if listeQualites.length}}
  <fieldset class="qualites-arme"><legend>Qualités (L'Art de l'escrime)</legend>
    <div class="grid-2">
      {{#each listeQualites}}
      <label class="ligne" title="{{effet}}"><span>{{label}} <span class="hint">{{effet}}</span></span>
        {{#if (eq max 1)}}<input type="checkbox" name="system.qualites.{{key}}" value="1" {{checked value}} data-dtype="Number">
        {{else}}<input type="number" name="system.qualites.{{key}}" value="{{value}}" min="0" max="{{max}}">{{/if}}</label>
      {{/each}}
    </div>
    <p class="hint">Appliqué automatiquement : Efficacité {{pn2Signed bonusQualites.eff}}D, Facilité {{pn2Signed bonusQualites.fac}}, dégâts {{pn2Signed bonusQualites.degats}}{{#if bonusQualites.portee}}, portée +{{bonusQualites.portee}} m{{/if}}{{#if bonusQualites.longFeu}}, long feu {{bonusQualites.longFeu}}{{/if}}. La Trempe ajoute des Points d'escrime, la Protection de la main protège le bras, la Pointe légère, le Prolongement du bras et le Brise-lame sont gérés en combat.</p>
  </fieldset>
  {{/if}}
  {{/if}}

  {{#if isType.armure}}
  <div class="grid-2">
    <div class="ligne"><label>Matière</label><select name="system.matiere"><option value="cuir" {{#if (eq system.matiere "cuir")}}selected{{/if}}>Cuir (+1)</option><option value="metal" {{#if (eq system.matiere "metal")}}selected{{/if}}>Métal (+2)</option></select></div>
    <div class="ligne"><label>Protection</label><input type="number" name="system.protection" value="{{system.protection}}"></div>
    <div class="ligne"><label>Malus Adresse (physique)</label><input type="number" name="system.malusAdr" value="{{system.malusAdr}}"></div>
    <div class="ligne"><label>Malus Adaptabilité (physique)</label><input type="number" name="system.malusAda" value="{{system.malusAda}}"></div>
    <div class="ligne"><label>Portée</label><input type="checkbox" name="system.equipee" {{checked system.equipee}}></div>
    <div class="ligne"><label>Prix</label><input type="text" name="system.prix" value="{{system.prix}}"></div>
  </div>
  <h3>Localisations protégées</h3>
  <div class="locs">{{#each locs}}<label class="checkbox"><input type="checkbox" name="system.localisations.{{key}}" {{checked checked}}> {{label}}</label>{{/each}}</div>
  {{/if}}

  {{#if isType.equipement}}
  <div class="grid-2">
    <div class="ligne"><label>Catégorie</label><input type="text" name="system.categorie" value="{{system.categorie}}"></div>
    <div class="ligne"><label>Quantité</label><input type="number" name="system.quantite" value="{{system.quantite}}"></div>
    <div class="ligne"><label>Prix</label><input type="text" name="system.prix" value="{{system.prix}}"></div>
    <div class="ligne"><label>Effet / modificateur</label><input type="text" name="system.modificateur" value="{{system.modificateur}}"></div>
  </div>
  {{/if}}

  {{#if isType.marchandise}}
  <div class="grid-2">
    <div class="ligne"><label>Unité de vente</label><input type="text" name="system.unite" value="{{system.unite}}"></div>
    <div class="ligne"><label>Tonnage par unité (T)</label><input type="number" step="any" name="system.tonnageUnite" value="{{system.tonnageUnite}}"></div>
    <div class="ligne"><label>Prix en pénurie (p8)</label><input type="number" step="any" name="system.prix.penurie" value="{{system.prix.penurie}}"></div>
    <div class="ligne"><label>Prix normal (p8)</label><input type="number" step="any" name="system.prix.normal" value="{{system.prix.normal}}"></div>
    <div class="ligne"><label>Prix en excès (p8)</label><input type="number" step="any" name="system.prix.exces" value="{{system.prix.exces}}"></div>
    <div class="ligne"><label>Cours actuel</label><select name="system.cours">{{selectOptions cours selected=system.cours}}</select></div>
    <div class="ligne"><label>Quantité (unités)</label><input type="number" step="any" name="system.quantite" value="{{system.quantite}}"></div>
    <div class="ligne"><label>Valeur</label><strong>{{valeurMarchandise}} pièces de huit</strong></div>
  </div>
  <p class="hint">Glissez une marchandise sur la fiche d'un navire pour la charger dans la cale.</p>
  {{/if}}

  {{#if isType.historique}}
  <div class="grid-2">
    <div class="ligne"><label>Étape</label><select name="system.etape">{{selectOptions etapes selected=system.etape}}</select></div>
    <div class="ligne"><label>Niveau des compétences</label><input type="number" name="system.niveau" value="{{system.niveau}}"></div>
    {{#if (eq system.etape "peuple")}}
      <div class="ligne"><label>Pays (séparés par des virgules)</label><input type="text" name="system.pays" value="{{system.pays}}"></div>
      <div class="ligne"><label>Armes à feu = métier</label><input type="checkbox" name="system.armesFeuMetier" {{checked system.armesFeuMetier}}></div>
    {{/if}}
    {{#if (eq system.etape "religion")}}<div class="ligne"><label>Compétence Religion (spécialité)</label><input type="text" name="system.religionNom" value="{{system.religionNom}}"></div>
      <div class="ligne"><label>Type de religion (magie)</label><select name="system.typeReligion"><option value="">— Aucun —</option>{{selectOptions typesReligion selected=system.typeReligion}}</select></div>{{/if}}
    <div class="ligne"><label>Caractéristiques au choix (+1)</label><input type="text" name="system.caracs" value="{{system.caracs}}" placeholder="ex. cha, adr"></div>
    {{#if (eq system.etape "profession")}}<div class="ligne"><label>Points à répartir</label><input type="number" name="system.points" value="{{system.points}}"></div>{{/if}}
    <div class="ligne"><label>Nombre de compétences à choisir</label><input type="number" name="system.nbCompetences" value="{{system.nbCompetences}}"></div>
  </div>
  {{#if (eq system.etape "peuple")}}<div class="ligne"><label>Compétences culturelles (niveau 2)</label><input type="text" name="system.culturelles" value="{{system.culturelles}}"></div>{{/if}}
  <h3>Compétences générales accessibles (maximum par catégorie)</h3>
  <div class="grid-3">{{#each categoriesList}}<label>{{label}} <input type="number" name="system.categories.{{key}}" value="{{value}}"></label>{{/each}}</div>
  <div class="ligne"><label>{{#if (eq system.etape "profession")}}Compétences de la profession (« choixCombat:2 » = 2 compétences de combat au choix){{else}}Compétences de métier accessibles{{/if}}</label><input type="text" name="system.metier" value="{{system.metier}}"></div>
  <div class="ligne"><label>Exclusions</label><input type="text" name="system.exclusions" value="{{system.exclusions}}"></div>
  <div class="ligne"><label>Remarque</label><input type="text" name="system.note" value="{{system.note}}"></div>
  <p class="hint">Compétences séparées par « ; » : clé (ex. navigation, escrime) ou groupe:spécialité (ex. art:Instrument de musique, armesJet:Javelot ; « art: » = au choix). Glissez cet objet sur un personnage pour lancer l'assistant ; le supprimer annule ses effets.</p>
  {{/if}}

  {{#if isType.avantage}}
  <div class="grid-2">
    <div class="ligne"><label>Nature</label><select name="system.nature">{{selectOptions natures selected=system.nature}}</select></div>
    <div class="ligne"><label>Catégorie</label><input type="text" name="system.categorie" value="{{system.categorie}}"></div>
    <div class="ligne"><label>Coût (PC)</label><input type="text" name="system.cout" value="{{system.cout}}"></div>
  </div>
  <div class="grid-2">
    <div class="ligne"><label>Variante retenue</label><input type="text" name="system.choix" value="{{system.choix}}"></div>
    <div class="ligne"><label>PC retenus <span class="hint">(vide = variante)</span></label><input type="number" name="system.pc" value="{{system.pc}}" placeholder="{{pcEffectifs}}"></div>
    <div class="ligne"><label>Effet automatique</label><select name="system.effet">{{selectOptions effets selected=system.effet}}</select></div>
    {{#if (eq system.effet "escrime")}}<div class="ligne"><label>Escrime ouverte</label><select name="system.escrimeType">{{selectOptions escrimeAcces selected=system.escrimeType}}</select></div>{{/if}}
    <div class="ligne"><label>Coût libre / plafond</label><span><input type="checkbox" name="system.variable" {{checked system.variable}}> <input type="number" name="system.maxPc" value="{{system.maxPc}}" min="0"></span></div>
    <div class="ligne"><label>Peut être pris plusieurs fois</label><input type="checkbox" name="system.multiple" {{checked system.multiple}}></div>
  </div>
  <div class="ligne"><label>Variantes (une par ligne : « Libellé : PC | modificateurs »)</label><textarea name="optionsTexte" rows="3">{{optionsTexte}}</textarea></div>
  <div class="ligne"><label>Prérequis / remarque</label><input type="text" name="system.prerequis" value="{{system.prerequis}}"></div>
  <div class="ligne"><label>Modificateurs automatiques</label><input type="text" name="system.modificateurs" value="{{system.modificateurs}}" placeholder="ex. discretion:-2, athletisme:-4, carac.for:-1"></div>
  <p class="hint">Syntaxe « clé:valeur » séparée par des virgules. Clés : compétences (discretion, natation, pratiqueNautique…), groupes (armesBlanches, armesFeu, artisanat…), catégories (combat, physiques…) → modificateur de Facilité ; « carac.xxx » → modifie la caractéristique.</p>
  {{/if}}

  {{#if isType.manoeuvre}}
  <div class="grid-2">
    <div class="ligne"><label>Type d'escrime</label><select name="system.escrime">{{selectOptions escrimeTypes selected=system.escrime}}</select></div>
    <div class="ligne"><label>Niveau</label><input type="number" name="system.niveau" value="{{system.niveau}}" min="1" max="4"></div>
    <div class="ligne"><label>Combinaison</label><input type="text" name="system.combinaison" value="{{system.combinaison}}" placeholder="ex. 1 1 0"></div>
    <div class="ligne"><label>Aperçu</label><span class="combo">{{{comboHTML}}} (puissance {{puissance}})</span></div>
    <div class="ligne"><label>Manœuvre d'école</label><input type="checkbox" name="system.ecole" {{checked system.ecole}}></div>
    <div class="ligne"><label>Seconde main libre / deux mains</label><span><input type="checkbox" name="system.secondeMain" {{checked system.secondeMain}}> <input type="checkbox" name="system.deuxMains" {{checked system.deuxMains}}></span></div>
    <div class="ligne"><label>Inadaptée contre</label><input type="text" name="system.inadapte" value="{{system.inadapte}}"></div>
    <div class="ligne"><label>Peu adaptée contre</label><input type="text" name="system.peuAdapte" value="{{system.peuAdapte}}"></div>
  </div>
  <div class="ligne"><label>Effet</label><textarea name="system.effet" rows="4">{{system.effet}}</textarea></div>
  <fieldset><legend>Effets automatisés</legend>
    <div class="grid-3">
      <label>+D attaque <input type="number" name="system.auto.bonusD" value="{{system.auto.bonusD}}"></label>
      <label>+Facilité <input type="number" name="system.auto.bonusFac" value="{{system.auto.bonusFac}}"></label>
      <label>-Facilité adverse <input type="number" name="system.auto.malusFacAdv" value="{{system.auto.malusFacAdv}}"></label>
      <label>+Succès <input type="number" name="system.auto.bonusS" value="{{system.auto.bonusS}}"></label>
      <label>+Dégâts <input type="number" name="system.auto.bonusDegats" value="{{system.auto.bonusDegats}}"></label>
      <label>Armure <input type="number" name="system.auto.armure" value="{{system.auto.armure}}"></label>
      <label class="checkbox"><input type="checkbox" name="system.auto.invulnerable" {{checked system.auto.invulnerable}}> Invulnérable</label>
      <label class="checkbox"><input type="checkbox" name="system.auto.annuleAdv" {{checked system.auto.annuleAdv}}> Annule la Réussite adverse</label>
      <label class="checkbox"><input type="checkbox" name="system.auto.choixLoc" {{checked system.auto.choixLoc}}> Choix de la localisation</label>
    </div>
  </fieldset>
  {{/if}}

  {{#if isType.alea}}
  <div class="grid-2">
    <div class="ligne"><label>Religion (clé, vide : toutes)</label><input type="text" name="system.religion" value="{{system.religion}}"></div>
    <div class="ligne"><label>Voie (clé, vide : toutes)</label><input type="text" name="system.voie" value="{{system.voie}}"></div>
    <div class="ligne"><label>Catégorie</label><select name="system.categorie">{{selectOptions categoriesAlea selected=system.categorie}}</select></div>
    <div class="ligne"><label>Sens</label><select name="system.conditions.sens">{{selectOptions sensAlea selected=system.conditions.sens}}</select></div>
    <div class="ligne"><label>Gravité</label><input type="number" name="system.gravite" value="{{system.gravite}}" min="0"></div>
    <div class="ligne"><label>Poids dans le tirage</label><input type="number" name="system.poids" value="{{system.poids}}" min="0"></div>
    <div class="ligne"><label>Visibilité par défaut</label><select name="system.visibilite">{{selectOptions visibilitesAlea selected=system.visibilite}}</select></div>
  </div>
  <div class="ligne"><label>Effet narratif</label><input type="text" name="system.effetNarratif" value="{{system.effetNarratif}}"></div>
  <div class="ligne"><label>Effet mécanique éventuel</label><input type="text" name="system.effetMecanique" value="{{system.effetMecanique}}"></div>
  <p class="hint">Tiré en secret (d10) pendant les actes sacrés, puis soumis au MJ (Entre ciel et terre, p. 95, 121).</p>
  {{/if}}

  {{#if isType.religion}}
  <div class="grid-2">
    <div class="ligne"><label>Type de religion</label><select name="system.type"><option value="">— À renseigner —</option>{{selectOptions typesReligion selected=system.type}}</select></div>
    <div class="ligne"><label>Groupe de Colère <span class="hint">(vide : la religion)</span></label><input type="text" name="system.groupeColere" value="{{system.groupeColere}}"></div>
  </div>
  <div class="ligne"><label>Religions de l'historique couvertes</label><input type="text" name="system.correspondances" value="{{system.correspondances}}" placeholder="ex. Catholique ; Protestant (huguenot, réformé)"></div>
  <h3>Voies d'illumination</h3>
  <ul class="pn2-references pn2-drop">
    {{#each voiesReferencees}}
      <li class="{{#if cassee}}alerte{{/if}}"><a data-action="ouvrirReference" data-uuid="{{uuid}}">{{nom}}</a>
        {{#if @root.editable}}<a class="pn2-mini-btn" data-action="retirerReference" data-uuid="{{uuid}}" title="Retirer la référence"><i class="fa-solid fa-xmark"></i></a>{{/if}}</li>
    {{else}}<li class="hint">Aucune Voie.</li>{{/each}}
    {{#if editable}}<li class="hint"><i class="fa-solid fa-hand-pointer"></i> Glissez une Voie ici pour la rattacher.</li>{{/if}}
  </ul>
  {{/if}}

  {{#if isType.voie}}
  <div class="grid-2">
    <div class="ligne pn2-drop"><label>Religion</label>
      {{#if religionRef}}<span class="{{#if religionRef.cassee}}alerte{{/if}}"><a data-action="ouvrirReference" data-uuid="{{religionRef.uuid}}">{{religionRef.nom}}</a>
        {{#if editable}}<a class="pn2-mini-btn" data-action="effacerReference" data-champ="religionUuid" title="Effacer la référence"><i class="fa-solid fa-xmark"></i></a>{{/if}}</span>
      {{else}}<input type="text" name="system.religion" value="{{system.religion}}" placeholder="Glissez une Religion ici">{{/if}}</div>
    <div class="ligne"><label>Domaine spirituel</label><input type="text" name="system.domaine" value="{{system.domaine}}"></div>
    <div class="ligne"><label>Clé de la Voie <span class="hint">(vide : {{cleVoie}})</span></label><input type="text" name="system.cle" value="{{system.cle}}" placeholder="{{cleVoie}}"></div>
    <div class="ligne"><label>Pas de Transe dans cette Voie</label><input type="checkbox" name="system.sansTranse" {{checked system.sansTranse}}></div>
    {{#if item.actor}}
    <div class="ligne"><label>Foi <span class="hint">(communion)</span></label><input type="number" name="system.foi" value="{{system.foi}}" min="0"></div>
    <div class="ligne"><label>Connaissance des Mystères <span class="hint">(possession)</span></label><input type="number" name="system.mysteres" value="{{system.mysteres}}" min="0"></div>
    <div class="ligne"><label>Affinité du personnage</label><input type="number" name="system.affinite" value="{{system.affinite}}"></div>
    {{/if}}
    <div class="ligne"><label>Groupe de Colère <span class="hint">(vide : religion du personnage)</span></label><input type="text" name="system.groupeColere" value="{{system.groupeColere}}"></div>
  </div>
  <div class="ligne"><label>Rites</label><input type="text" name="system.rites" value="{{system.rites}}"></div>
  {{#if item.actor}}<p class="hint">Foi / Connaissance des Mystères et Affinité sont propres au personnage (Entre ciel et terre, p. 90).</p>{{/if}}
  <h3>Pouvoirs de la Voie</h3>
  <ul class="pn2-references">
    {{#each pouvoirsVoie}}<li><span class="tag">P{{puissance}}</span> <a data-action="ouvrirReference" data-uuid="{{uuid}}">{{nom}}</a></li>
    {{else}}<li class="hint">Aucun Pouvoir rattaché.</li>{{/each}}
  </ul>
  {{/if}}

  {{#if isType.pouvoir}}
  <div class="grid-2">
    <div class="ligne pn2-drop"><label>Voie</label>
      {{#if voieRef}}<span class="{{#if voieRef.cassee}}alerte{{/if}}"><a data-action="ouvrirReference" data-uuid="{{voieRef.uuid}}">{{voieRef.nom}}</a>
        {{#if editable}}<a class="pn2-mini-btn" data-action="effacerReference" data-champ="voieUuid" title="Effacer la référence"><i class="fa-solid fa-xmark"></i></a>{{/if}}</span>
      {{else}}<input type="text" name="system.voie" value="{{system.voie}}" placeholder="Glissez une Voie ici (ou sa clé)">{{/if}}</div>
    <div class="ligne"><label>Puissance</label><input type="number" name="system.puissance" value="{{system.puissance}}" min="1" max="10"></div>
    <div class="ligne"><label>Nom en langue native</label><input type="text" name="system.nomNatif" value="{{system.nomNatif}}"></div>
    <div class="ligne"><label>Accessible <span class="hint">(compulsion assouvie)</span></label><input type="checkbox" name="system.accessible" {{checked system.accessible}}></div>
  </div>
  {{#if item.actor}}<p class="hint">Voie sur le personnage : {{#if voiePossedee}}{{voiePossedee.nom}}{{#if (eq voiePossedee.mode "cle")}} (par sa clé){{/if}}{{else}}<span class="alerte">introuvable — ajoutez la Voie au personnage</span>{{/if}}</p>{{/if}}
  <div class="ligne"><label>Compulsion</label><input type="text" name="system.compulsion" value="{{system.compulsion}}"></div>
  <div class="ligne"><label>Visions</label><input type="text" name="system.visions" value="{{system.visions}}"></div>
  <div class="ligne"><label>Conditions et particularités</label><input type="text" name="system.conditions" value="{{system.conditions}}"></div>
  {{#if @root.isGM}}
  <fieldset><legend>Effets mécaniques (MJ)</legend>
    <div class="ligne"><label>Application</label><select name="system.application">{{selectOptions applications selected=system.application}}</select></div>
    <ul class="pn2-references">
      {{#each effetsPouvoir}}<li><img src="{{img}}" width="16" height="16"> {{name}}
        <a class="pn2-mini-btn" data-action="effetEditer" data-id="{{id}}"><i class="fa-solid fa-pen"></i></a>
        {{#if @root.editable}}<a class="pn2-mini-btn" data-action="effetSupprimer" data-id="{{id}}"><i class="fa-solid fa-trash"></i></a>{{/if}}</li>
      {{else}}<li class="hint">Aucun effet : l'intervention reste narrative.</li>{{/each}}
    </ul>
    {{#if editable}}<a class="pn2-btn petit" data-action="effetCreer"><i class="fa-solid fa-plus"></i> Effet (Active Effect)</a>{{/if}}
    <p class="hint">Les effets sont copiés sur les cibles quand le MJ les applique, avec la Durée effective du Pouvoir (table p. 100).</p>
  </fieldset>
  {{/if}}
  {{#if parametresVisibles}}
  <fieldset><legend>Paramètres de base <span class="hint">(réservés au MJ selon le supplément)</span></legend>
    <div class="grid-2">
      <div class="ligne"><label>Portée</label><input type="text" name="system.portee" value="{{system.portee}}"></div>
      <div class="ligne"><label>Cible</label><input type="text" name="system.cible" value="{{system.cible}}"></div>
      <div class="ligne"><label>Impact</label><input type="text" name="system.impact" value="{{system.impact}}"></div>
      <div class="ligne"><label>Durée</label><input type="text" name="system.duree" value="{{system.duree}}"></div>
    </div>
  </fieldset>
  <div class="ligne"><label>Références de règles</label><input type="text" name="system.references" value="{{system.references}}"></div>
  {{/if}}
  {{/if}}

  {{#if isType.objetPouvoir}}
  <div class="grid-2">
    <div class="ligne"><label>Nature</label><select name="system.nature">{{selectOptions naturesObjet selected=system.nature}}</select></div>
    <div class="ligne"><label>Forme</label><input type="text" name="system.forme" value="{{system.forme}}" list="formes-{{item.id}}" placeholder="Baume, Wanga, Relique…">
      <datalist id="formes-{{item.id}}">{{#each formesObjet}}<option value="{{this}}">{{/each}}</datalist></div>
    <div class="ligne"><label>Mode</label><select name="system.mode">{{selectOptions modesObjet selected=system.mode}}</select></div>
    {{#if ephemere}}
    <div class="ligne"><label>Doses restantes</label><input type="number" name="system.doses" value="{{system.doses}}" min="0"></div>
    {{else}}
    <div class="ligne"><label>Durée d'activation <span class="hint">(coût)</span></label><select name="system.dureeActivation">{{selectOptions dureesObjet selected=system.dureeActivation}}</select></div>
    {{/if}}
  </div>
  {{#unless ephemere}}
  <div class="ligne"><label>Rites d'activation</label><input type="text" name="system.rites" value="{{system.rites}}" placeholder="Sacrifice, danse, drogue… pendant toute la Durée d'activation"></div>
  <div class="ligne"><label>Dernière utilisation</label><input type="text" name="system.derniereUtilisation" value="{{system.derniereUtilisation}}" placeholder="Date du jeu"></div>
  {{/unless}}

  {{#if isGM}}
  <fieldset><legend>Pouvoir contenu (MJ)</legend>
    <div class="grid-2">
      <div class="ligne pn2-drop"><label>Pouvoir</label>
        {{#if pouvoirRef}}<span class="{{#if pouvoirRef.cassee}}alerte{{/if}}"><a data-action="ouvrirReference" data-uuid="{{pouvoirRef.uuid}}">{{pouvoirRef.nom}}</a>
          {{#if editable}}<a class="pn2-mini-btn" data-action="effacerReference" data-champ="pouvoirUuid" title="Effacer la référence"><i class="fa-solid fa-xmark"></i></a>{{/if}}</span>
        {{else}}<input type="text" name="system.pouvoir" value="{{system.pouvoir}}" placeholder="Glissez un Pouvoir ici">{{/if}}</div>
      <div class="ligne"><label>Voie</label><input type="text" name="system.voie" value="{{system.voie}}"></div>
      <div class="ligne"><label>Puissance <span class="hint">(= Impact)</span></label><input type="number" name="system.puissance" value="{{system.puissance}}" min="1" max="10"></div>
      <div class="ligne"><label>Le possesseur connaît le Pouvoir</label><input type="checkbox" name="system.pouvoirConnu" {{checked system.pouvoirConnu}}></div>
      <div class="ligne"><label>Portée</label><input type="text" name="system.portee" value="{{system.portee}}"></div>
      <div class="ligne"><label>Cible</label><input type="text" name="system.cible" value="{{system.cible}}"></div>
      <div class="ligne"><label>Durée</label><input type="text" name="system.duree" value="{{system.duree}}"></div>
      {{#unless ephemere}}
      <div class="ligne"><label>Fréquence d'utilisation <span class="hint">(coût)</span></label><select name="system.frequence">{{selectOptions frequencesObjet selected=system.frequence}}</select></div>
      {{/unless}}
    </div>
    <p class="hint">
      {{#if ephemere}}
        Création : par un Rituel invoquant le Pouvoir, une dose par Succès sacré ; par une Transe (Pouvoir dans le Chemin), une dose par Succès sacré au-delà de la Puissance ({{cout.puissance}}).
      {{else}}
        Création : un Rituel invoquant le Pouvoir avec au moins <strong>{{cout.total}} Succès sacrés</strong>
        (Puissance {{cout.puissance}} + Fréquence {{cout.frequence}} + Durée d'activation {{cout.duree}}).
      {{/if}}
      Il faut aussi connaître le Pouvoir qui permet de créer ce type d'objet (Entre ciel et terre, p. 160-161).
    </p>
  </fieldset>
  {{else}}
    {{#if system.pouvoirConnu}}<p><strong>Pouvoir :</strong> {{system.pouvoir}}{{#if system.voie}} ({{system.voie}}){{/if}}</p>{{/if}}
  {{/if}}
  <p class="hint">Utilisation : {{#if ephemere}}consommer une dose ; la réussite est automatique.{{else}}tenir l'objet, formuler un souhait, accomplir les rites pendant toute la Durée d'activation, puis réussir un Test d'Objets de pouvoir (Charisme) avec au moins 2 Succès ; le MJ déclenche l'effet dans les 24 h. Attendre ensuite la Fréquence d'utilisation.{{/if}}</p>
  {{/if}}

  <h3>Description</h3>
  <div class="description-apercu">{{{descriptionHTML}}}</div>
  <textarea name="system.description" rows="6">{{system.description}}</textarea>
  <div class="ligne"><label>Source</label><input type="text" name="system.source" value="{{system.source}}"></div>
</div>
