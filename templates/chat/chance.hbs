<div class="pn2-card pn2-test">
  <header class="card-header"><h3>Test de Chance</h3></header>
  <p>Probabilité {{proba}}/10, Chance {{pn2Signed chance}} → réussite sur {{seuil}} ou moins.</p>
  <div class="pn2-dice"><span class="die {{#if ok}}ok{{else}}ko{{/if}}">{{total}}</span></div>
  <div class="resultat {{#if ok}}reussite{{else}}echec{{/if}}"><span class="succes">{{#if ok}}Le hasard est favorable{{else}}Pas de chance…{{/if}}</span></div>
</div>
